# Zoho Mail Configuration
# SMTP settings: https://www.zoho.com/mail/help/zoho-smtp.html
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
# Zoho Mail account (full email address)
ZOHO_USER=seu-email@zoho.com
# App password generated in Zoho Mail security settings
ZOHO_APP_PASSWORD=
# Sender email (must match the Zoho Mail account or an authorized alias)
ZOHO_FROM_EMAIL=seu-email@zoho.com
# Admin email that receives contact form notifications
ZOHO_TO_EMAIL=seu-email@exemplo.com

# Google reCAPTCHA v3 Configuration
# Site Key (pública - pode ser exposta no frontend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret Key (privada - apenas no servidor)
RECAPTCHA_SECRET_KEY=

# Rate Limiting — Vercel KV (produção) ou memória (fallback local)
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=3600000

# Agendamento (LinkedIn por padrão; substitua por Calendly se tiver)
NEXT_PUBLIC_SCHEDULING_URL=https://www.linkedin.com/in/natanaelvich/

# Demos em vídeo (Loom) — opcional; sem URL usa walkthrough com screenshots
NEXT_PUBLIC_DEMO_LOOM_AI_RESUME=
NEXT_PUBLIC_DEMO_LOOM_AI_MARKETPLACE=
NEXT_PUBLIC_DEMO_LOOM_AI_ASK_RECORDER=
